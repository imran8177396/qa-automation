{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Single-config QA automation pipeline for Playwright, Postman, JMeter, and GitHub Actions",
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test:e2e": "tsx scripts/run-playwright-e2e.ts",
    "test:e2e:headed": "tsx scripts/run-playwright-e2e.ts --headed",
    "test:e2e:report": "playwright show-report reports/playwright",
    "test:api": "postman collection run tests/api/postman/collection.json -e tests/api/postman/environment.json -r cli,json --reporter-json-export reports/postman/report.json",
    "test:performance": "tsx scripts/run-jmeter.ts",
    "test:all": "tsx scripts/run-all.ts",
    "qa": "tsx scripts/run-qa.ts",
    "qa:sync": "tsx scripts/sync-from-config.ts",
    "qa:api": "tsx scripts/run-qa.ts --step=api",
    "qa:e2e": "tsx scripts/run-qa.ts --step=e2e",
    "qa:load": "tsx scripts/run-qa.ts --step=load",
    "test": "npm run test:all",
    "docs:generate": "tsx scripts/txt-to-docx.ts",
    "docs:sample": "tsx scripts/txt-to-docx.ts --input=docs/input/sample-report.txt",
    "docs:qa-report": "tsx scripts/generate-qa-report.ts",
    "rules:sync": "tsx scripts/sync-cursor-rules.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "dotenv": "^16.4.7",
    "postman-cli": "^1.27.0",
    "docx": "^9.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
