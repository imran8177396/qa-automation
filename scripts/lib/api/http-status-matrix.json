      "result": "FAIL"
    },
    {
      "test": "delete_resource",
      "expected": 204,
      "actual": 204,
      "result": "PASS"
    }
  ],
  "engine_instructions": [
    "Always prioritize the API specification over generic HTTP conventions.",
    "Never automatically classify every 4xx response as a test failure.",
    "Never automatically classify every 2xx response as complete success.",
    "Compare expected status with actual status.",
    "Validate response body and schema in addition to status code.",
    "Generate negative tests for authentication, authorization, validation, conflicts, unsupported methods, rate limits, and malformed requests.",
    "Use SPECIFICATION_REQUIRED when expected behavior cannot be determined.",
    "Record the exact actual status code in every test result.",
    "Include a failure reason whenever expected and actual behavior differ.",
    "Treat 401 as authentication-related and 403 as authorization-related unless the API specification states otherwise.",
    "Treat 422 as validation/business-rule related when applicable.",
    "Treat 429 as rate-limit related.",
    "Treat 5xx responses as server-side failures unless the test explicitly expects a server failure.",
    "Do not invent status-code expectations."
  ]
}
