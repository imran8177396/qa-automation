{
  "version": "1.0.0",
  "purpose": "Machine-readable HTTP status code knowledge base for QA automation, API testing, Postman, Playwright API tests, and automated reporting.",
  "classification": {
    "1xx": "informational",
    "2xx": "success",
    "3xx": "redirection",
    "4xx": "client_error",
    "5xx": "server_error"
  },
  "evaluation_rules": {
    "pass_rule": "actual_status == expected_status",
    "fail_rule": "actual_status != expected_status",
    "unknown_expected_status": "SPECIFICATION_REQUIRED",
    "do_not_assume_4xx_is_failure": true,
    "do_not_assume_2xx_means_complete_success": true,
    "api_specification_has_priority": true
  },
  "statuses": {
    "100": {
      "name": "Continue",
      "category": "informational",
      "outcome": "Request headers received; client may continue.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "low"
    },
    "101": {
      "name": "Switching Protocols",
      "category": "informational",
      "outcome": "Server is switching protocols.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "medium"
    },
    "102": {
      "name": "Processing",
      "category": "informational",
      "outcome": "Server is processing the request.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "low"
    },
    "103": {
      "name": "Early Hints",
      "category": "informational",
      "outcome": "Preliminary response headers are provided before the final response.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "low"
    },
    "200": {
      "name": "OK",
      "category": "success",
      "outcome": "Request completed successfully.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "critical"
    },
    "201": {
      "name": "Created",
      "category": "success",
      "outcome": "A new resource was successfully created.",
      "typical_methods": [
        "POST"
      ],
      "qa_relevance": "critical"
    },
    "202": {
      "name": "Accepted",
      "category": "success",
      "outcome": "Request accepted for asynchronous processing.",
      "typical_methods": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "high"
    },
    "203": {
      "name": "Non-Authoritative Information",
      "category": "success",
      "outcome": "Response contains information that may differ from the origin server.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "low"
    },
    "204": {
      "name": "No Content",
      "category": "success",
      "outcome": "Request succeeded with no response body.",
      "typical_methods": [
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "critical",
      "response_body_expected": false
    },
    "205": {
      "name": "Reset Content",
      "category": "success",
      "outcome": "Request succeeded; client should reset the view.",
      "typical_methods": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "qa_relevance": "low"
    },
    "206": {
      "name": "Partial Content",
      "category": "success",
      "outcome": "Partial resource content returned.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "medium"
    },
    "207": {
      "name": "Multi-Status",
      "category": "success",
      "outcome": "Multiple operation results are returned.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "qa_relevance": "low"
    },
    "208": {
      "name": "Already Reported",
      "category": "success",
      "outcome": "Resource was already reported.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "low"
    },
    "226": {
      "name": "IM Used",
      "category": "success",
      "outcome": "GET request fulfilled using instance manipulation.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "low"
    },
    "300": {
      "name": "Multiple Choices",
      "category": "redirection",
      "outcome": "Multiple possible representations or resources exist.",
      "typical_methods": [
        "GET"
      ],
      "qa_relevance": "low"
    },
    "301": {
      "name": "Moved Permanently",
      "category": "redirection",
      "outcome": "Resource permanently moved.",
      "typical_methods": [
        "GET",
        "HEAD"
      ],
      "qa_relevance": "medium"
    },
    "302": {
      "name": "Found",
      "category": "redirection",
      "outcome": "Resource temporarily redirected.",
      "typical_methods": [
        "GET",
        "POST"
      ],
      "qa_relevance": "medium"
    },
    "303": {
      "name": "See Other",
      "category": "redirection",
      "outcome": "Client should retrieve another URL.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "low"
    },
    "304": {
      "name": "Not Modified",
      "category": "redirection",
      "outcome": "Cached representation can be reused.",
      "typical_methods": [
        "GET",
        "HEAD"
      ],
      "qa_relevance": "medium"
    },
    "305": {
      "name": "Use Proxy",
      "category": "redirection",
      "outcome": "Proxy should be used.",
      "status": "obsolete",
      "qa_relevance": "none"
    },
    "306": {
      "name": "Switch Proxy",
      "category": "redirection",
      "outcome": "Reserved and unused.",
      "status": "reserved",
      "qa_relevance": "none"
    },
    "307": {
      "name": "Temporary Redirect",
      "category": "redirection",
      "outcome": "Temporary redirect while preserving HTTP method.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "medium",
      "preserve_method": true
    },
    "308": {
      "name": "Permanent Redirect",
      "category": "redirection",
      "outcome": "Permanent redirect while preserving HTTP method.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "qa_relevance": "medium",
      "preserve_method": true
    },
    "400": {
      "name": "Bad Request",
      "category": "client_error",
      "outcome": "Request is malformed or invalid.",
      "typical_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
