  "common_api_expectations": {
    "create": {
      "method": "POST",
      "typical_success_statuses": [
        201
      ],
      "alternative_success_statuses": [
        200,
        202
      ]
    },
    "read": {
      "method": "GET",
      "typical_success_statuses": [
        200
      ],
      "alternative_success_statuses": [
        206
      ]
    },
    "update": {
      "methods": [
        "PUT",
        "PATCH"
      ],
