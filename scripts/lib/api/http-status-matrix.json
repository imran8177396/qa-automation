  "classification_examples": [
    {
      "test": "successful_create",
      "expected": 201,
      "actual": 201,
      "result": "PASS"
    },
    {
      "test": "successful_create",
      "expected": 201,
      "actual": 500,
      "result": "FAIL"
    },
    {
      "test": "invalid_login",
      "expected": 401,
