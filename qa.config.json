{
  "project": {
    "name": "Contact List App QA Automation"
  },
  "urls": {
    "website": "https://thinking-tester-contact-list.herokuapp.com",
    "api": "https://thinking-tester-contact-list.herokuapp.com",
    "login": "https://thinking-tester-contact-list.herokuapp.com/",
    "contactList": "https://thinking-tester-contact-list.herokuapp.com/contactList",
    "signup": "https://thinking-tester-contact-list.herokuapp.com/addUser"
  },
  "credentials": {
    "username": "qa.test@example.com",
    "password": "Password123!"
  },
  "pipeline": {
    "steps": ["sync", "api", "e2e", "load"],
    "failFast": true
  },
  "postman": {
    "enabled": true,
    "collectionName": "Contact List API Smoke",
    "assertions": {
      "statusCode": 200,
      "expectJson": false
    },
    "requests": [
      {
        "name": "GET homepage",
        "method": "GET",
        "path": "/"
      },
      {
        "name": "GET contact list page",
        "method": "GET",
        "path": "/contactList"
      }
    ]
  },
  "playwright": {
    "enabled": true,
    "baseURL": "https://thinking-tester-contact-list.herokuapp.com",
    "browsers": ["chromium", "firefox", "webkit"],
    "headless": true
  },
  "jmeter": {
    "enabled": true,
    "threads": 5,
    "rampUpSeconds": 5,
    "loopCount": 1,
    "path": "/"
  },
  "github": {
    "branches": ["main", "master"],
    "runOnPullRequest": true
  },
  "report": {
    "enabled": true,
    "format": "docs/templates/qa-test-results.format.json",
    "autoGenerateAfterTests": true
  }
}
