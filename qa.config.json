{
  "project": {
    "name": "Swag Labs QA Automation"
  },
  "urls": {
    "website": "https://www.saucedemo.com",
    "api": "https://www.saucedemo.com",
    "login": "https://www.saucedemo.com/",
    "inventory": "https://www.saucedemo.com/inventory.html",
    "checkout": "https://www.saucedemo.com/checkout-step-one.html"
  },
  "credentials": {
    "username": "standard_user",
    "password": "secret_sauce"
  },
  "pipeline": {
    "steps": ["sync", "api", "e2e", "load"],
    "failFast": true
  },
  "postman": {
    "enabled": true,
    "collectionName": "Swag Labs API Smoke",
    "assertions": {
      "statusCode": 200,
      "expectJson": false
    },
    "requests": [
      {
        "name": "GET homepage",
        "method": "GET",
        "path": "/"
      }
    ]
  },
  "playwright": {
    "enabled": true,
    "baseURL": "https://www.saucedemo.com",
    "browsers": ["chromium", "firefox", "webkit"],
    "headless": true
  },
  "jmeter": {
    "enabled": true,
    "threads": 5,
    "rampUpSeconds": 5,
    "loopCount": 1,
    "path": "/"
  },
  "github": {
    "branches": ["main", "master"],
    "runOnPullRequest": true
  },
  "report": {
    "enabled": true,
    "format": "docs/templates/qa-test-results.format.json",
    "autoGenerateAfterTests": true
  }
}
