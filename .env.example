# Copy to .env and fill in real values. Never commit .env to Git.
# Leave targets empty unless you set a real site/API for this run.
# The engine does not default to any public demo website or API.
QA_WEBSITE_URL=
QA_API_URL=
QA_PLAYWRIGHT_BASE_URL=
QA_PLAYWRIGHT_HEADLESS=true
QA_PLAYWRIGHT_BROWSERS=
QA_LOGIN_URL=

# UI credentials come from env and are never hardcoded.
# Leave empty when the target does not document credentials
# (auth-dependent checks stay REQUIRES_CONFIGURATION).
# Never commit a filled .env.
QA_USERNAME=
QA_PASSWORD=

# API auth placeholders. Leave empty unless the target documents authentication.
# Never commit a filled .env.
QA_API_TOKEN=
QA_API_USERNAME=
QA_API_PASSWORD=

# Optional JMeter profile override. Empty = liveness (smoke is an alias).
# Heavy profiles still require QA_PERF_AUTHORIZE or --authorize-heavy.
QA_JMETER_PROFILE=

# Heavy JMeter profiles (load/stress/spike/soak) are never implied.
# Set to true or 1 only when you explicitly authorize a heavy run
# against loopback or a host in jmeter.allowHeavyAgainst. CI must not set this.
QA_PERF_AUTHORIZE=

# --- GitHub Actions (Settings → Secrets and variables → Actions) ---
# Map these as repository secrets. Never commit filled values.
# QA_WEBSITE_URL=
# QA_API_URL=
# QA_PLAYWRIGHT_BASE_URL=
# QA_USERNAME=
# QA_PASSWORD=
# QA_API_TOKEN=
# QA_API_USERNAME=
# QA_API_PASSWORD=
#
# Optional Actions *variable* (not a secret) for the weekly heavy JMeter schedule:
# QA_PERF_AUTHORIZE_SCHEDULE=true
# Still requires jmeter.allowHeavyAgainst. Never set QA_PERF_AUTHORIZE on the PR workflow.

# --- Jenkins (Manage Jenkins → Credentials) ---
# Create Secret text IDs. Never put real values in this file or in Jenkinsfiles.
# Missing IDs bind as empty (auth-dependent checks stay REQUIRES_CONFIGURATION).
# qa-website-url  → QA_WEBSITE_URL (recorded; PR/regression keep the fixture origin)
# qa-api-url      → QA_API_URL
# qa-username     → QA_USERNAME
# qa-password     → QA_PASSWORD
# qa-api-token    → QA_API_TOKEN
# qa-api-username → QA_API_USERNAME
# qa-api-password → QA_API_PASSWORD
# Heavy JMeter: Jenkinsfile.performance parameter AUTHORIZE_HEAVY (default false).
# Never set QA_PERF_AUTHORIZE on the Multibranch / PR Jenkinsfile.
